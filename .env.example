# --- AI ---
# Pour le cloud : gemini. En local sans clé : ollama.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Local Ollama (optionnel) ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
REVIAI_MODEL=llama3.2

# --- Flask ---
SESSION_SECRET=change-moi-avec-une-longue-valeur-aleatoire
PUBLIC_BASE_URL=http://127.0.0.1:5000
PORT=5000
MAX_UPLOAD_MB=20

# --- Publicité (désactivée par défaut)
ADS_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
ADSENSE_PUBLISHER_ID=
