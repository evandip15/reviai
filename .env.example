# --- AI ---
# Pour le cloud : gemini. En local sans clé : ollama.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Local Ollama (optionnel) ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
REVIAI_MODEL=llama3.2

# --- Flask ---
SESSION_SECRET=change-moi-avec-une-longue-valeur-aleatoire
PUBLIC_BASE_URL=http://127.0.0.1:5000
PORT=5000
MAX_UPLOAD_MB=20

# --- OCR local des photos (si AI_PROVIDER=ollama)
# Chemin Windows courant : C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Publicité (désactivée par défaut)
ADS_ENABLED=false
# À laisser à false tant qu'une CMP certifiée n'est pas installée et vérifiée.
ADS_CONSENT_READY=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
ADSENSE_PUBLISHER_ID=
